<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panel_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_date_dark"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/panel_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_sun" />

        <TextView
            android:id="@+id/panel_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/panel_date"
            android:textColor="@color/ink_soft_dark"
            android:textSize="14sp" />

        <!-- A spacer has to be a @RemoteView class; a bare View is rejected by
             RemoteViews inflation and takes the whole panel down with it. -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/panel_expand"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:alpha="0.35"
            android:contentDescription="@null"
            android:src="@drawable/ic_expand_dark" />
    </LinearLayout>

    <TextView
        android:id="@+id/panel_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:lineSpacingExtra="3dp"
        android:text="@string/sample_date"
        android:textColor="@color/ink_soft_dark"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/panel_cta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/cta_bg_dark"
        android:gravity="center"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:text="@string/cta_era_legis"
        android:textColor="@color/ink_soft_dark"
        android:textSize="14sp" />
</LinearLayout>
