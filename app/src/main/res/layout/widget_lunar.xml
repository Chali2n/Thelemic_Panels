<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panel_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_lunar"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/panel_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_phases" />

        <TextView
            android:id="@+id/panel_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/panel_lunar"
            android:textColor="@color/ink_soft"
            android:textSize="14sp" />

        <!-- A spacer has to be a @RemoteView class; a bare View is rejected by
             RemoteViews inflation and takes the whole panel down with it. -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/panel_expand"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:alpha="0.35"
            android:contentDescription="@null"
            android:src="@drawable/ic_expand" />
    </LinearLayout>

    <TextView
        android:id="@+id/panel_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="3dp"
        android:text="@string/sample_lunar_summary"
        android:textColor="@color/ink_soft"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/stat1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/tile_bg"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/stat1_top"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sample_lunar_phase"
                android:textColor="@color/ink_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/stat1_mid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/sample_lunar_lit"
                android:textColor="@color/ink"
                android:textSize="19sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/stat2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/tile_bg"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/stat2_top"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sample_lunar_sign_caption"
                android:textColor="@color/ink_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/stat2_mid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/sample_lunar_sign"
                android:textColor="@color/ink"
                android:textSize="19sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/event1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/tile_bg"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/event1_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sample_lunar_new_when"
            android:textColor="@color/ink_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/event1_mid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/sample_lunar_new"
            android:textColor="@color/ink"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/event2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/tile_bg"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/event2_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sample_lunar_full_when"
            android:textColor="@color/ink_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/event2_mid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/sample_lunar_full"
            android:textColor="@color/ink"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/panel_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/ink_muted"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
