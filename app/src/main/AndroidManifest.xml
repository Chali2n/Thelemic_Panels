<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The four dark panels. These class names are the ones the panels have
             always used, so widgets already pinned keep their ids and repaint in
             the dark palette instead of being dropped by the launcher. -->
        <receiver
            android:name=".ThelemicDateWidget"
            android:exported="true"
            android:label="@string/panel_date">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/thelemic_date_info" />
        </receiver>

        <receiver
            android:name=".LunarWidget"
            android:exported="true"
            android:label="@string/panel_lunar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lunar_info" />
        </receiver>

        <receiver
            android:name=".ReshWidget"
            android:exported="true"
            android:label="@string/panel_resh">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/resh_info" />
        </receiver>

        <receiver
            android:name=".PlanetaryHoursWidget"
            android:exported="true"
            android:label="@string/panel_hours">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/hours_info" />
        </receiver>
    </application>
</manifest>
