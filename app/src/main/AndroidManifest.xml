<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".ThelemicDateWidget"
            android:exported="true"
            android:label="@string/panel_date">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/thelemic_date_info" />
        </receiver>

        <receiver
            android:name=".LunarWidget"
            android:exported="true"
            android:label="@string/panel_lunar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lunar_info" />
        </receiver>

        <receiver
            android:name=".ReshWidget"
            android:exported="true"
            android:label="@string/panel_resh">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/resh_info" />
        </receiver>

        <receiver
            android:name=".PlanetaryHoursWidget"
            android:exported="true"
            android:label="@string/panel_hours">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/hours_info" />
        </receiver>

        <receiver
            android:name=".ThelemicDateDarkWidget"
            android:exported="true"
            android:label="@string/panel_date_dark">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/thelemic_date_dark_info" />
        </receiver>

        <receiver
            android:name=".LunarDarkWidget"
            android:exported="true"
            android:label="@string/panel_lunar_dark">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lunar_dark_info" />
        </receiver>

        <receiver
            android:name=".ReshDarkWidget"
            android:exported="true"
            android:label="@string/panel_resh_dark">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/resh_dark_info" />
        </receiver>

        <receiver
            android:name=".PlanetaryHoursDarkWidget"
            android:exported="true"
            android:label="@string/panel_hours_dark">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/hours_dark_info" />
        </receiver>
    </application>
</manifest>
